":0.9,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":2},{"id":"edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","type":"changed_by","src":"service:payments-api|prod","dst":"change_event:chg-1","origin":"discovered","props":{},"confidence":null,"source_reliability":0.9,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":2},{"id":"edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered","type":"introduced_by","src":"change_event:chg-1","dst":"code_commit:abc123","origin":"discovered","props":{},"confidence":null,"source_reliability":0.9,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":2},{"id":"edge:affects:incident:inc-4821->service:payments-api|prod:discovered","type":"affects","src":"incident:inc-4821","dst":"service:payments-api|prod","origin":"discovered","props":{},"confidence":null,"source_reliability":0.9,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":2},{"id":"edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","type":"changed_by","src":"service:payments-api|prod","dst":"change_event:chg-1","origin":"discovered","props":{},"confidence":null,"source_reliability":0.9,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":2},{"id":"edge:introduced_by:change_event:chg-1->code_commit: