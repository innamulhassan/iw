 and timeline"],"verdict":{"status":"advance","confidence":{"value":0.3,"basis":"FRAME required calls issued and Anomaly onset fact emitted to satisfy min_facts>=1; evidence lands next turn for investigate.","deriver":null},"gate_result":"pass","gate_reason":null},"rejections":[]},"action":null,"observation":null,"decision":null,"available":null,"plan_calls":null,"plan_ops":null,"todos":null,"todo":null,"refs":{"nodes":["incident:inc-4821","service:payments-api|prod","change_event:chg-1","service:payments-api|prod","code_commit:abc123","service:payments-api|prod","database:payments-ora","service:payments-api|prod","database:payments-ora","incident:inc-4821","service:payments-api|prod","change_event:chg-1","service:payments-api|prod","code_commit:abc123","incident:inc-4821","service:payments-api|prod","change_event:chg-1","service:payments-api|prod","code_commit:abc123","incident:inc-4821","service:payments-api|prod","change_event:chg-1","service:payments-api|prod","code_commit:abc123","anomaly:anom-inc-4821"],"edges":["edge:affects:incident:inc-4821->service:payments-api|prod:discovered","edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered","edge:depends_on:service:payments-api|prod->database:payments-ora:declared","edge:depends_on:service:payments-api|prod->database:payments-ora:declared","edge:affects:incident:inc-4821->service:payments-api|prod:discovered","edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered","edge:affects:incident:inc-4821->service:payments-api|prod:discovered","edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered","edge:affects:incident:inc-4821->service:payments-api|prod:discovered","edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered"],"facts":["fact:4a1c466cf46c79bc"],"events":["evt:8ad3f3d52cdecb52","evt:f11f7436dca6c5f8","evt:8ad3f3d52cdecb52","evt:f11f7436dca6c5f8","evt:8ad3f3d52cdecb52","evt:f11f7436dca6c5f8","evt:8ad3f3d52cdecb52","evt:f11f7436dca6c5f8"],"hypotheses":[]}}
