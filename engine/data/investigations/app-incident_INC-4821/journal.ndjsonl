database:payments-ora","origin":"declared","props":{},"confidence":null,"source_reliability":1.0,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":2},{"id":"edge:affects:incident:inc-4821->service:payments-api|prod:discovered","type":"affects","src":"incident:inc-4821","dst":"service:payments-api|prod","origin":"discovered","props":{},"confidence":null,"source_reliability":0.9,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":2},{"id":"edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","type":"changed_by","src":"service:payments-api|prod","dst":"change_event:chg-1","origin":"discovered","props":{},"confidence":null,"source_reliability":0.9,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":2},{"id":"edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered","type":"introduced_by","src":"change_event:chg-1","dst":"code_commit:abc123","origin":"discovered","props":{},"confidence":null,"source_reliability":0.9,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":2}],"hypotheses_updated":[],"retractions":[],"remaps":[],"narrative":"Framing INC-4821: pulling incident, changes, and topology; seeding Anomaly symptom with onset fact.","next_actions":["Inspect incident payload and changes to refine onset/severity and propose rival hypotheses"],"verdict":{"status":"advance","confidence":{"value":0.3,"basis":"Frame gate will be satisfied by Anomaly onset fact plus tool-seeded nodes once calls land.","deriver":null},"gate_result":"pass","gate_reason":null},"rejections":[]},"action":null,"observation":null,"decision":null,"available":null,"plan_calls":null,"plan_ops":null,"todos":null,"todo":null,"refs":{"nodes":["incident:inc-4821","service:payments-api|prod","change_event:chg-1","service:payments-api|prod","code_commit:abc123","incident:inc-4821","service:payments-api|prod","change_event:chg-1","service:payments-api|prod","code_commit:abc123","incident:inc-4821","service:payments-api|prod","change_event:chg-1","service:payments-api|prod","code_commit:abc123","service:payments-api|prod","database:payments-ora","service:payments-api|prod","database:payments-ora","incident:inc-4821","service:payments-api|prod","change_event:chg-1","service:payments-api|prod","code_commit:abc123","anomaly:anom-inc-4821"],"edges":["edge:affects:incident:inc-4821->service:payments-api|prod:discovered","edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered","edge:affects:incident:inc-4821->service:payments-api|prod:discovered","edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered","edge:affects:incident:inc-4821->service:payments-api|prod:discovered","edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered","edge:depends_on:service:payments-api|prod->database:payments-ora:declared","edge:depends_on:service:payments-api|prod->database:payments-ora:declared","edge:affects:incident:inc-4821->service:payments-api|prod:discovered","edge:changed_by:service:payments-api|prod->change_event:chg-1:discovered","edge:introduced_by:change_event:chg-1->code_commit:abc123:discovered"],"facts":["fact:4a1c466cf46c79bc"],"events":["evt:8ad3f3d52cdecb52","evt:f11f7436dca6c5f8","evt:8ad3f3d52cdecb52","evt:f11f7