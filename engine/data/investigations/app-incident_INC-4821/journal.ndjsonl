alue":"2026-07-19T14:25:00+00:00","unit":null,"valid_from":"2026-07-19T14:25:00Z","valid_to":null,"observed_at":"2026-07-19T14:25:00Z","source":"splunk","source_native_name":"last_seen","confidence":null,"source_reliability":0.95,"evidence":[],"supersedes":null,"state":"active","provisional":false,"created_by":16},{"id":"fact:8af3d0cbbbb8bbe9","subject_ref":"service:payments-api|prod","predicate":"degraded","value":false,"unit":null,"valid_from":"2026-07-19T14:35:00Z","valid_to":null,"observed_at":"2026-07-19T14:35:00Z","source":"prometheus","source_native_name":"degraded","confidence":null,"source_reliability":0.9,"evidence":[],"supersedes":"fact:8e8d7285985098b7","state":"active","provisional":false,"created_by":16}],"events_added":[{"id":"evt:7b2736f10a0a1b77","entity_ref":"anomaly:anom-inc-4821","type":"cleared","occurred_at":"2026-07-19T14:35:00Z","observed_at":"2026-07-19T14:35:00Z","payload":{},"source":"prometheus","source_native_name":"cleared","state":"active","invalidated_by":null,"provisional":false,"created_by":16}],"spans_added":[],"nodes_touched":[{"id":"service:payments-api|prod","type":"service","props":{"service_name":"payments-api","env":"prod"},"source":null,"aliases":{},"provisional":false,"created_by":16},{"id":"service:payments-api|prod","type":"service","props":{"service_name":"payments-api","env":"prod"},"source":null,"aliases":{},"provisional":false,"created_by":16},{"id":"service:payments-api|prod","type":"service","props":{"service_name":"payments-api","env":"prod"},"source":null,"aliases":{},"provisional":false,"created_by":16},{"id":"error_signature:npe-taxcalc","type":"error_signature","props":{"signature_hash":"npe-taxcalc","exception_class":"java.lang.NullPointerException","first_seen":"2026-07-19T14:00:00+00:00","file_line":"TaxCalculator.java:88"},"source":null,"aliases":{},"provisional":false,"created_by":16},{"id":"service:payments-api|prod","type":"service","props":{"service_name":"payments-api","env":"prod"},"source":null,"alia