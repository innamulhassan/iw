-> payments-api 5xx, remediation, recovery timeline."],"verdict":{"status":"advance","confidence":{"value":0.9,"basis":"Recovery facts emitted (anomaly cleared event + service degraded=false); leader h1 confirmed; verify gate satisfied.","deriver":null},"gate_result":"pass","gate_reason":null},"rejections":[]},"action":null,"observation":null,"decision":null,"available":null,"plan_calls":null,"plan_ops":null,"todos":null,"todo":null,"refs":{"nodes":["service:payments-api|prod","service:payments-api|prod","service:payments-api|prod","error_signature:npe-taxcalc","service:payments-api|prod","error_signature:npe-taxcalc"],"edges":["edge:emitted:service:payments-api|prod->error_signature:npe-taxcalc:discovered","edge:emitted:service:payments-api|prod->error_signature:npe-taxcalc:discovered"],"facts":["fact:67aa463e08be61da","fact:8e8d7285985098b7","fact:67aa463e08be61da","fact:8e8d7285985098b7","fact:fdf1e069353d0eba","fact:b5e4bc0cc2c1c9f5","fact:fdf1e069353d0eba","fact:b5e4bc0cc2c1c9f5","fact:8af3d0cbbbb8bbe9"],"events":["evt:7b2736f10a0a1b77"],"hypotheses":["hyp:h1"]}}
