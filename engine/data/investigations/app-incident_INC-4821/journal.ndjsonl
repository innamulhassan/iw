().getCode());  // v4.12.0: getRegion() is null for intl orders -> NPE"}],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":6},{"id":"edge:caused_by:error_signature:npe-taxcalc->code_commit:abc123:inferred","type":"caused_by","src":"error_signature:npe-taxcalc","dst":"code_commit:abc123","origin":"inferred","props":{},"confidence":{"value":0.9,"basis":"caused_by edge","deriver":null},"source_reliability":null,"evidence":[{"kind":"blame","ref":"TaxCalculator.java:88","label":"return calc.rate(order.getRegion().getCode());  // v4.12.0: getRegion() is null for intl orders -> NPE"}],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":6},{"id":"edge:caused_by:error_signature:npe-taxcalc->code_commit:abc123:inferred","type":"caused_by","src":"error_signature:npe-taxcalc","dst":"code_commit:abc123","origin":"inferred","props":{},"confidence":{"value":0.9,"basis":"caused_by edge","deriver":null},"source_reliability":null,"evidence":[{"kind":"blame","ref":"TaxCalculator.java:88","label":"return calc.rate(order.getRegion().getCode());  // v4.12.0: getRegion() is null for intl orders -> NPE"}],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":6},{"id":"edge:fired_on:alert:alt-1->service:payments-api|prod:discovered","type":"fired_on","src":"alert:alt-1","dst":"service:payments-api|prod","origin":"discovered","props":{},"confidence":null,"source_reliability":0.9,"evidence":[],"source":null,"source_native_name":null,"valid_from":null,"observed_at":null,"state":"active","valid_to":null,"invalidated_by":null,"supersedes":null,"provisional":false,"created_by":6},{"id":"edge:fired_on:alert:alt